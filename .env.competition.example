# Competition / public demo configuration. Copy to .env on the demo machine and fill in the tokens and the model key.
# Simulation only: no chain, no live payments, a separate demo space, and sign-up for judges.

# Refuse to start if anything below wires up real payments (EVM_RPC_URL or ENABLE_LIVE_PAYMENTS).
PUBLIC_DEPLOY=true
ENABLE_LIVE_PAYMENTS=false
EVM_RPC_URL=

# Judges can create their own account (each gets an empty, private workspace) or press "Try the demo" (a separate demo space).
ALLOW_SIGNUP=true
ENABLE_DEMO_LOGIN=true
# Behind HTTPS (recommended for anything reachable from outside): mark the session cookie Secure.
COOKIE_SECURE=true

FINANCE_DB=data/finance.sqlite3
FRONTEND_PORT=8787
ENABLE_WORKER=true
SANDBOX_SETTLE_SECONDS=8

# Long random values (at least 24 characters), different from each other. Never commit the real ones.
OWNER_TOKEN=
AGENT_TOKEN=

# The AI model. Account and card numbers and emails are replaced by placeholders before anything is sent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_BASE_URL=

# Email stays off unless an SMTP server is set.
SMTP_HOST=
