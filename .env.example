# Docker reads .env via compose. For finance.cli, export these in the shell (the program does not read .env itself).
FINANCE_DB=data/finance.sqlite3
# Frontend binds to loopback only; the backend stays on the internal Docker network.
FRONTEND_PORT=8787
# Local-only convenience: auto owner session. Refused whenever a live (non-testnet) chain is configured.
ENABLE_DEMO_LOGIN=false
COOKIE_SECURE=false
OWNER_TOKEN=replace-with-a-long-random-owner-token
AGENT_TOKEN=replace-with-a-different-long-random-agent-token
# Any OpenAI-compatible Chat Completions endpoint with tool calling. Empty = offline rule planner (labeled, not AI).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# The agent's own wallet. Leave EVM_RPC_URL empty to run the local sandbox only.
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_CHAIN_ID=11155111
EVM_CONFIRMATIONS=3
# Encrypted keystore is created once at <FINANCE_DB dir>/agent.keystore.json with this password (12+ chars).
AGENT_WALLET_PASSWORD=
EVM_KEYSTORE_PATH=
# Dev only, discouraged: a raw key instead of the keystore.
EVM_PRIVATE_KEY=
# Non-Sepolia chains need this deliberate opt-in plus a matching chain ID and a separate database.
ENABLE_LIVE_PAYMENTS=false
EVM_MAX_GAS_PRICE_GWEI=30
MAX_PAYMENT_ETH=0.01
DAILY_PAYMENT_ETH=0.05
MAX_PAYMENT_AUD=500
DAILY_PAYMENT_AUD=1000
# Seconds until a submitted local-sandbox payment settles (shows async tracking).
SANDBOX_SETTLE_SECONDS=8
ENABLE_WORKER=true
