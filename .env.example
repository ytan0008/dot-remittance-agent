# Local HTTP demo. Run python scripts/configure.py to generate .env and random tokens.
# Compose loads .env; Python CLI/server processes do not load it automatically.
PUBLIC_DEPLOY=false
COOKIE_SECURE=false
FRONTEND_PORT=8787
FINANCE_DB=data/finance.sqlite3
ALLOW_SIGNUP=true
ENABLE_DEMO_LOGIN=true
ENABLE_WORKER=true
SANDBOX_SETTLE_SECONDS=8

# Required, distinct values of at least 24 characters. Never publish real tokens.
OWNER_TOKEN=
AGENT_TOKEN=
# Optional read-only API credential; also distinct and 24+ characters if set.
VIEWER_TOKEN=

# Empty key = labelled rule-based planner. Choose a model supported by your provider/account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
# Empty uses the SDK default endpoint. Custom compatible endpoints generally end in /v1.
OPENAI_BASE_URL=

# Local simulation only: no real money or blockchain connection.
ENABLE_ONCHAIN=false
ENABLE_LIVE_PAYMENTS=false
EVM_RPC_URL=
MAX_PAYMENT_AUD=500
DAILY_PAYMENT_AUD=1000

# Optional email: Resend takes priority over SMTP. Empty = preview only.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
